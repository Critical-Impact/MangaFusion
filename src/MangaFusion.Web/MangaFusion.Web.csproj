<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MangaFusion.Application\MangaFusion.Application.csproj" />
    <ProjectReference Include="..\MangaFusion.Infrastructure\MangaFusion.Infrastructure.csproj" />
    <ProjectReference Include="..\MangaFusion.Contracts\MangaFusion.Contracts.csproj" />
    <ProjectReference Include="..\MangaFusion.Sources.MangaDex\MangaFusion.Sources.MangaDex.csproj" />
    <ProjectReference Include="..\MangaFusion.Sources.ComicVine\MangaFusion.Sources.ComicVine.csproj" />
    <ProjectReference Include="..\MangaFusion.Sources.MangaUpdates\MangaFusion.Sources.MangaUpdates.csproj" />
    <ProjectReference Include="..\MangaFusion.Sources.Web\MangaFusion.Sources.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.Storage.SQLite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Version: CI passes /p:GitVersion=… (tag like "1.2.3" or short SHA for non-tag builds).
       Local builds show "local" so the distinction is visible in the UI. The property that actually
       feeds [AssemblyInformationalVersionAttribute] is InformationalVersion, not
       AssemblyInformationalVersion (that name doesn't correspond to any SDK-recognized property and
       silently does nothing). The SDK also auto-appends "+<full 40-char git SHA>" onto
       InformationalVersion whenever a .git folder is present (IncludeSourceRevisionInInformationalVersion
       defaults true) — disabled below so our own value comes through unmodified instead of e.g.
       "local+1bbeb9370e6d8ec9155be5b0f42a34c4fbc34fef". -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(GitVersion)' != ''">$(GitVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(GitVersion)' == ''">local</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- Standalone self-contained single-file publish, selected by publishing with a RuntimeIdentifier
       (dotnet publish -r RID). Gated on that RID so a plain build/test/run and the framework-dependent
       Docker publish are unaffected. No trimming: EF Core, Autofac and Hangfire are reflection-heavy
       and trimming breaks them at runtime. IncludeNativeLibrariesForSelfExtract folds the SQLite
       native (e_sqlite3) into the bundle; compression keeps the size down. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- No MSBuild property alias exists for System.GC.ConserveMemory, so it's set directly as a
       RuntimeHostConfigurationOption (same mechanism ServerGarbageCollection above expands to).
       9 = most aggressive: the GC favors returning committed memory to the OS over throughput. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

</Project>
